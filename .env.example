# Database Configuration
# DB_USERNAME must be able to SET ROLE app_user (the superuser postgres can).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=accounting_saas_dev

# JWT Configuration - generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Application Environment
NODE_ENV=development
PORT=3000

# Database Logging (Optional)
DB_LOGGING=false

# Billing
# Payment gateway: only "mock" is implemented (hosted page simulated by the web app).
PAYMENT_PROVIDER=mock
# Public URL of the web app; payment gateways redirect customers back here.
APP_URL=http://localhost:5173

# API docs (Swagger UI at /api/docs, OpenAPI JSON at /api/docs-json).
# On by default unless NODE_ENV=production; set true/false to override.
# SWAGGER_ENABLED=true

# Production hardening (TASK-15)
# The API refuses to start in production as a superuser/BYPASSRLS role; use db/create-app-login.sql.
# DB_ALLOW_PRIVILEGED_ROLE=false
# Browser origins allowed in production (defaults to APP_URL), comma-separated.
# CORS_ORIGINS=https://app.example.com
# Behind a load balancer/reverse proxy: hops or subnets to trust for the client IP (rate limits use it).
# TRUST_PROXY=1
# Failed sign-ins per account before a lockout, and the lockout/window length.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# Multiplies the per-IP limits on public endpoints (1 = production values). Raise only for local testing.
# RATE_LIMIT_SCALE=1
